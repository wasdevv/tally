# Copie para .env e preencha. NENHUM valor real entra no repositorio.
#
# As duas chaves abaixo se geram, nao se inventam:
#   openssl rand -hex 32

# Segredo compartilhado do HMAC entre motor e console. Tem que ser o MESMO
# valor dos dois lados -- e o que autentica uma ponta para a outra.
# Minimo de 32 caracteres; o motor recusa subir com menos.
TALLY_HMAC_SECRET=

# Senha do PostgreSQL do motor.
TALLY_DB_PASSWORD=

# Chave de sessao do Rails: bin/rails secret
SECRET_KEY_BASE=

# Portas publicadas no host. Descomente so se alguma ja estiver ocupada na sua
# maquina -- porta fixa no compose funciona em maquina limpa, e nenhuma maquina
# de dev e limpa.
# TALLY_CONSOLE_PORT=3000
# TALLY_ENGINE_PORT=8080
# TALLY_DB_PORT=5432
