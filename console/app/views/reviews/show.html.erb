<% content_for :title, t("reviews.show.title", line: @entry["line"]) %>

<p><%= link_to t("reviews.show.back"), batch_path(@batch["id"], status: "NEEDS_REVIEW"), class: "min-h-11 inline-flex items-center" %></p>

<h1 class="mt-2 text-[25px] font-semibold leading-tight">
  <%= t("reviews.show.title", line: @entry["line"]) %>
</h1>

<%# A linha do banco, primeiro: e contra ela que o operador compara. %>
<dl class="mt-4 grid max-w-[52rem] grid-cols-[auto_1fr] gap-x-6 gap-y-1">
  <dt class="font-medium"><%= t("batches.show.amount") %></dt>
  <dd class="tabular text-[25px] font-semibold"><%= format_cents(@entry["amountCents"]) %></dd>

  <dt class="font-medium"><%= t("batches.show.paid") %></dt>
  <dd class="tabular"><%= table_date(@entry["paidAt"]) %></dd>

  <dt class="font-medium"><%= t("batches.show.our_number") %></dt>
  <dd class="tabular"><%= @entry["ourNumber"].presence || t("batches.show.none") %></dd>

  <dt class="font-medium"><%= t("batches.show.counterpart") %></dt>
  <dd><%= @entry["counterparty"].presence || t("batches.show.none") %></dd>
</dl>

<%# Por que isto virou revisao: o motor sabia algo, e o operador precisa saber. %>
<p class="mt-3 max-w-[72ch]" style="color: var(--review)">
  <%= match_reason_label(@entry["matchReason"]) %>
</p>

<h2 class="mt-6 text-[20px] font-medium"><%= t("reviews.show.candidates") %></h2>

<% if @entry["candidates"].blank? %>
  <p class="mt-2 max-w-[72ch]"><%= t("reviews.show.no_candidates") %></p>
<% end %>

<%= form_with url: batch_review_path(@batch["id"], @entry["line"]), method: :patch,
              class: "mt-3 max-w-[52rem]" do |form| %>
  <% @entry["candidates"].each do |candidate| %>
    <label class="band flex min-h-11 flex-wrap items-baseline gap-x-4 gap-y-1 border-b py-3"
           style="border-color: var(--rule)">
      <%= form.radio_button :receivable_id, candidate["id"], class: "size-5" %>
      <span class="tabular font-semibold"><%= format_cents(candidate["amountCents"]) %></span>
      <span class="tabular"><%= candidate["ourNumber"] %></span>
      <span class="tabular"><%= table_date(candidate["dueDate"]) %></span>
      <span><%= candidate["payer"] %></span>
    </label>
  <% end %>

  <%# "Nenhum destes" nao apaga a linha: ela volta para o razao como pendencia. %>
  <label class="flex min-h-11 flex-wrap items-baseline gap-x-4 py-3">
    <%= form.radio_button :receivable_id, "", class: "size-5", checked: @entry["candidates"].blank? %>
    <span><%= t("reviews.show.none_of_these") %></span>
  </label>

  <%= form.submit t("reviews.show.submit"),
                  class: "mt-3 min-h-11 w-full border px-4 font-medium sm:w-auto",
                  style: "border-color: var(--ink)" %>
<% end %>
