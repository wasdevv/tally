<% content_for :title, t("imports.new.title") %>

<h1 class="text-[25px] font-semibold leading-tight"><%= t("imports.new.title") %></h1>

<% if @error %>
  <div class="mt-4"><%= render "shared/error", error: @error %></div>
<% end %>

<%= form_with url: import_path, method: :post, multipart: true, class: "mt-6 max-w-[72ch]" do |form| %>
  <%= form.label :file, t("imports.new.file"), class: "block font-medium" %>
  <%= form.file_field :file, required: true, class: "mt-2 block min-h-11 w-full" %>
  <p class="mt-1 text-[12.8px]"><%= t("imports.new.hint") %></p>

  <%= form.submit t("imports.new.submit"),
                  class: "mt-4 min-h-11 border px-4 font-medium",
                  style: "border-color: var(--ink)" %>
<% end %>
