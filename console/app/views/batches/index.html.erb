<% content_for :title, t("batches.index.title") %>

<h1 class="text-[25px] font-semibold leading-tight"><%= t("batches.index.title") %></h1>

<% if @batches.empty? %>
  <%# Vazio e convite, com a acao ali. %>
  <div class="mt-6 max-w-[72ch]">
    <p><%= t("batches.index.empty") %></p>
    <p class="mt-4">
      <%= link_to t("batches.index.empty_action"), new_import_path,
                  class: "inline-flex min-h-11 items-center border px-4 font-medium",
                  style: "border-color: var(--ink)" %>
    </p>
  </div>
<% else %>
  <ul class="mt-6 divide-y" style="border-color: var(--rule)">
    <% @batches.each do |batch| %>
      <li class="band py-3">
        <%= link_to batch_path(batch["id"]), class: "flex flex-wrap items-baseline gap-x-4 gap-y-1" do %>
          <span class="tabular text-[25px] font-semibold" style="color: <%= batch["unreconciledCents"].to_i.zero? ? "var(--matched)" : "var(--divergence)" %>">
            <%= format_cents(batch["unreconciledCents"]) %>
          </span>
          <span><%= batch["filename"] %></span>
          <span class="text-[12.8px]"><%= t("batches.index.lines", count: batch["lineCount"]) %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
