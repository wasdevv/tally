<% content_for :title, t("receivables.index.title") %>

<h1 class="text-[25px] font-semibold leading-tight"><%= t("receivables.index.title") %></h1>

<% if @receivables.empty? %>
  <p class="panel mt-6 max-w-[52rem] p-8"><%= t("receivables.index.empty") %></p>
<% else %>
  <div class="scroll-x mt-6">
    <table class="ledger min-w-[40rem] text-[14px]">
      <thead>
        <tr>
          <th scope="col" class="text-start"><%= t("receivables.index.our_number") %></th>
          <th scope="col" class="text-end"><%= t("receivables.index.amount") %></th>
          <th scope="col" class="text-start"><%= t("receivables.index.due") %></th>
          <th scope="col" class="text-start"><%= t("receivables.index.payer") %></th>
        </tr>
      </thead>
      <tbody>
        <% @receivables.each do |receivable| %>
          <tr>
            <td class="tabular"><%= receivable["ourNumber"] %></td>
            <td class="tabular text-end"><%= format_cents(receivable["amountCents"]) %></td>
            <td class="tabular"><%= table_date(receivable["dueDate"]) %></td>
            <td><%= receivable["payer"] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
